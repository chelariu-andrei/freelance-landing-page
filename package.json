{
  "name": "ac-design-system",
  "version": "0.1.0",
  "description": "Ac. design system — React + TypeScript + Tailwind + Framer Motion",
  "engines": { "node": ">=24" },
  "main": "src/index.ts",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-placeholders.mjs",
    "build": "next build",
    "prebuild:site": "node scripts/check-placeholders.mjs",
    "build:site": "next build",
    "test": "node --test \"tests/*.test.*\"",
    "test:visual": "playwright test",
    "typecheck": "tsc -p .",
    "build:bundle": "node build.mjs",
    "build:css": "tailwindcss -i src/styles.css -o dist/bundle.css --minify",
    "build:lib": "npm run build:bundle && npm run build:css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
