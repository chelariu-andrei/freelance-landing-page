{
  "name": "ac-design-system",
  "version": "0.1.0",
  "description": "Ac. design system — React + TypeScript + Tailwind + Framer Motion",
  "main": "src/index.ts",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-placeholders.mjs",
    "build": "next build",
    "prebuild:site": "node scripts/check-placeholders.mjs",
    "build:site": "next build",
    "test": "node --test \"tests/*.test.*\"",
    "test:visual": "playwright test",
    "typecheck": "tsc -p .",
    "build:bundle": "node build.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles.css -o dist/bundle.css --minify",
    "build:lib": "npm run build:bundle && npm run build:css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.23.1",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "3.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.453.0",
    "next": "^14.2.35",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18",
    "tailwind-merge": "^2.6.1",
    "three": "^0.186.1"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  }
}
